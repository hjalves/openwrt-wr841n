config tvremote 'main'
	# The TV: a Samsung UE32K5500 (2016 Tizen), wired. Its address must not
	# change: it's set statically on the TV, outside the Huawei's DHCP pool
	# (.200-.250), because the Huawei can't reserve addresses.
	option host '192.168.0.20'
	option mac 'f8:3f:51:76:91:85'
	# Wake-on-LAN goes to this broadcast address (UDP port 9).
	option broadcast '192.168.0.255'
	# The TV's remote-control WebSocket (plain ws://, no token on this model).
	option port '8001'
	# Name this remote gives the TV (shown in its Device Connection Manager).
	option name 'OpenWrt'

	# Seconds between checks while the TV is off, so switching it on with
	# its own remote is noticed (0 = only check when asked to switch it on).
	option poll '30'
	# Give up waking the TV after this many seconds (it takes about 10-15).
	option wake_timeout '40'
	# After KEY_POWER the TV stays on the network for about 17 s; nothing is
	# sent to it during this many seconds.
	option off_window '25'
