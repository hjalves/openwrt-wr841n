#!/bin/sh /etc/rc.common
# procd service for lanwatch (devices on the LAN)

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/lanwatch

start_service() {
	local enabled interface device wifi sweep state_file

	config_load lanwatch
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get interface main interface lan
	config_get wifi main wifi wlan0
	config_get sweep main sweep 300
	config_get state_file main state_file /srv/lanwatch/devices.dat
	. /lib/functions/network.sh
	network_get_device device "$interface"
	[ -n "$device" ] || device="br-$interface"

	procd_open_instance
	procd_set_param command "$PROG" -i "$device" -w "$wifi" -t "$sweep" -f "$state_file"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lanwatch
}
