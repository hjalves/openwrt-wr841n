config lanwatch 'main'
	option enabled '1'
	# Logical network to watch (its bridge device is looked up from netifd)
	option interface 'lan'
	# This access point's Wi-Fi interface, for client signal ('' = none)
	option wifi 'wlan0'
	# Seconds between gentle ARP sweeps of the subnet (60 or more)
	option sweep '300'
	# Device list on flash (first seen, names): written when a new device
	# appears (at most every 10 min), once a day if changed, and on stop.
	# Empty = keep it in RAM only (every device looks new after a reboot).
	option state_file '/srv/lanwatch/devices.dat'
