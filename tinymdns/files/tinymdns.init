#!/bin/sh /etc/rc.common
# procd service for tinymdns (minimal mDNS / DNS-SD advertiser)

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/tinymdns

add_service() {
	local cfg="$1" name type port txt t arg

	config_get name "$cfg" name
	config_get type "$cfg" type _http._tcp
	config_get port "$cfg" port 80
	config_get txt "$cfg" txt
	[ -n "$name" ] || return 0
	arg="$type,$port,$name"
	for t in $txt; do arg="$arg,$t"; done
	procd_append_param command -s "$arg"
}

start_service() {
	local enabled hostname interface device

	config_load tinymdns
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get hostname main hostname
	[ -n "$hostname" ] || hostname="$(uci -q get system.@system[0].hostname)"
	config_get interface main interface lan
	. /lib/functions/network.sh
	network_get_device device "$interface"
	[ -n "$device" ] || device="br-$interface"

	procd_open_instance
	procd_set_param command "$PROG" -i "$device" -n "${hostname:-openwrt}"
	config_foreach add_service service
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger tinymdns system
}
