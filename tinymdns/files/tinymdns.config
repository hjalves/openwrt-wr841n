config tinymdns 'main'
	option enabled '1'
	# Logical network to serve (its bridge device is looked up from netifd)
	option interface 'lan'
	# Answer for <hostname>.local; empty = the system hostname, lowercased
	#option hostname 'openwrt'

# DNS-SD services to advertise (at most 4). Names may contain spaces but no
# commas; each txt entry is one key=value string without spaces.
config service
	option name 'LTE data usage'
	option type '_http._tcp'
	option port '80'
	list txt 'path=/traffic.html'

config service
	option name 'OpenWrt router'
	option type '_http._tcp'
	option port '80'
	list txt 'path=/'
