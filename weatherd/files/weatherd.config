config weatherd 'main'
	# TCP port the station posts to. Set the station's "customized" upload
	# (Ecowitt protocol) to http://<router>:8080/ every 60 s.
	option port '8080'
	# Accept uploads only from this address (the station's), and only with
	# its PASSKEY (shown in the station's own uploads). Empty = not checked.
	option station '192.168.0.200'
	option passkey ''

	# Fine tier: every upload. 4320 x ~64 s = ~3 days, ~185 KiB RAM.
	option history '4320'
	# Hourly summaries: 9600 x 1 h = ~13 months, ~410 KiB RAM when full.
	option coarse_interval '3600'
	option coarse_history '9600'

	# RAM tiers, loaded at start and written on stop (/tmp: lost on reboot).
	option state_file '/tmp/weatherd.dat'
	option save_every '0'

	# Hourly summaries on flash too, so they survive reboots: about 21 bytes
	# per hour, one file per month, 13 months kept (~190 KiB at most).
	# Appended every flash_every seconds and on a clean stop.
	option flash_dir '/srv/weatherd'
	option flash_every '86400'
