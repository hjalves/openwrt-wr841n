config huawei-trafficd 'main'
	# Huawei HiLink router to poll (anonymous API, no password needed)
	option host '192.168.0.1'
	option port '80'
	# Seconds between samples
	option interval '60'
	# Samples kept in RAM (40 bytes each): 4320 x 60 s = 3 days, ~170 KiB
	option history '4320'
	# History file loaded at start and written on stop. /tmp survives daemon
	# restarts but not reboots. A flash path survives reboots, but avoid
	# frequent writes to this router's small JFFS2 flash.
	option state_file '/tmp/huawei-trafficd.dat'
	# Additionally write the history file every N seconds (0 = only on stop)
	option save_every '0'
