config huawei-trafficd 'main'
	# Huawei HiLink router to poll (anonymous API, no password needed)
	option host '192.168.0.1'
	option port '80'
	# Also log LTE signal (RSRP/RSRQ/SINR/RSSI, cell) and connection status:
	# two more anonymous requests per sample. 0 = traffic counters only.
	option signal '1'
	# Measure internet latency and packet loss: one ICMP echo every 10 s,
	# alternating between the targets (about 25-30 MB of LTE data a month).
	# An outage is when no target answers while the Huawei itself does.
	option latency '1'
	list target '1.1.1.1'
	list target '8.8.8.8'
	# Also ping the Huawei itself (host above) every 10 s: that only crosses
	# the local link (here a powerline), so trouble there can be told apart
	# from trouble on the LTE side. Stays on the LAN: no LTE data.
	option gateway_ping '1'
	# Also record the powerline's PHY rate in both directions: once per
	# sample, one HomePlug AV statistics request (read-only, LAN only) to
	# the powerline network's coordinator, which reports the rate to and
	# from our own adapter. Set both MACs to turn it on; empty = off.
	# Here the coordinator is the adapter at the Huawei, and the station is
	# the adapter at this router.
	option plc_coordinator '5c:e9:31:ba:49:6a'
	option plc_station '5c:e9:31:ba:41:5f'
	# Interface to ask on: the LAN bridge reaches the adapter on any port.
	option plc_iface 'br-lan'

	# Fine tier: every sample. 4320 x 60 s = 3 days, ~340 KiB RAM.
	option interval '60'
	option history '4320'

	# Coarse tier: first sample of each period. 8760 x 1 h = 365 days,
	# ~685 KiB RAM when full. Set coarse_interval to 0 to disable it.
	option coarse_interval '3600'
	option coarse_history '8760'

	# History files, loaded at start and written on stop. /tmp survives
	# daemon restarts but not reboots. The coarse tier defaults to
	# <state_file>.coarse. A full year of coarse history (~685 KiB) does
	# NOT fit in this router's flash; see README before using a flash path.
	option state_file '/tmp/huawei-trafficd.dat'
	#option coarse_state_file '/tmp/huawei-trafficd.dat.coarse'

	# Additionally write the history files every N seconds (0 = only on stop)
	option save_every '0'

	# Keep the hourly history on flash too, so it survives reboots and power
	# cuts: compressed (~18 bytes/hour), one file per month, 13 months kept
	# (~160 KiB at most). New hours are appended every flash_every seconds
	# and on a clean stop; a power cut loses at most that much hourly data.
	# Leave flash_dir empty to turn this off (then delete the directory to
	# free the space).
	option flash_dir '/srv/huawei-trafficd'
	option flash_every '86400'
