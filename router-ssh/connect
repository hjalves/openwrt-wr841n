#!/bin/sh
# Usage: connect [command...]   (no command: interactive shell)
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cmd_args="$*"
set --
. "$script_dir/common.sh"
if [ -n "$cmd_args" ]; then
    router_exec ssh "$@" "$router_user@$router_host" "$cmd_args"
fi
router_exec ssh "$@" "$router_user@$router_host"
